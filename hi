.ticker { height: 56px;
          display: flex; 
          align-items: center; 
          overflow: hidden; 
          background: linear-gradient(100deg,#00d980,#00a879); 
          color: white; 
          white-space: nowrap; 
          font-size: 18px; 
          font-weight: 800; 
          letter-spacing: .035em; 
        }

.ticker-track { display: flex; 
                width: max-content; 
                animation: ticker-scroll 32s linear infinite; 
              }

.ticker:hover .ticker-track { animation-play-state: paused; }

.ticker-group { display: flex; 
                align-items: center; 
                gap: 18px; 
                padding-right: 18px; 
              }

.ticker-group b { font-size: 18px; 
                  opacity: .9; 
                }
